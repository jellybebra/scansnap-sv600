+
+  memset(cmd, 0, cmdLen);
+  set_SCSI_opcode(cmd, SEND_code);
+  set_S_xfer_datatype(cmd, S_datatype_lut_data);
+  set_S_xfer_length(cmd, outLen);
+
+  memset(out, 0, outLen);
+  set_S_lut_order(out, S_lut_order_single);
+  set_S_lut_ssize(out, S_lut_data_min_len);
+  set_S_lut_dsize(out, 256);
+
+  /* The SV600 firmware requires a downloaded 8-bit LUT even though its
+   * inquiry data reports no downloadable gamma tables.  The Windows driver
+   * sends this neutral table on every scan. */
+  for (i = 0; i < S_lut_data_min_len; i++)
+    out[S_lut_header_len + i] = i;
+
+  DBG (10, "sv600_send_lut: start\n");
+  ret = do_cmd (
+    s, 1, 0,
+    cmd, cmdLen,
+    out, outLen,
+    NULL, NULL
+  );
+  DBG (10, "sv600_send_lut: finish %d\n", ret);
+
+  return ret;
+}
+
+static SANE_Status
+sv600_prepare_scan (struct fujitsu *s)
+{
+  static const unsigned char scan_mode[] = {0x20, 0x00, 0x00};
+  static const unsigned char ir_on[] = {0x01};
+  static const unsigned char ir_off[] = {0x00};
+  SANE_Status ret;
+
+  if (!strstr(s->model_name, "SV600"))
+    return SANE_STATUS_GOOD;
+
+  DBG (10, "sv600_prepare_scan: start\n");
+
+  ret = sv600_send_diagnostic(s, "SET SCAN MODE", scan_mode,
+                              sizeof(scan_mode));
+  if (ret != SANE_STATUS_GOOD) {
+    DBG (5, "sv600_prepare_scan: SET SCAN MODE failed: %d\n", ret);
+    return ret;
+  }
+
+  ret = sv600_send_diagnostic(s, "CHANGE IRLED", ir_on, sizeof(ir_on));
+  if (ret != SANE_STATUS_GOOD) {
+    DBG (5, "sv600_prepare_scan: CHANGE IRLED on failed: %d\n", ret);
+    return ret;
+  }
+
+  /* The Windows driver lets the positioning camera settle while the
+   * infrared reference light is on, then turns it off before SCAN. */
+  usleep(1500000);
+
+  ret = sv600_send_diagnostic(s, "CHANGE IRLED", ir_off, sizeof(ir_off));
+  if (ret != SANE_STATUS_GOOD) {
+    DBG (5, "sv600_prepare_scan: CHANGE IRLED off failed: %d\n", ret);
+    return ret;
+  }
+
+  ret = sv600_send_lut(s);
+  if (ret != SANE_STATUS_GOOD) {
+    DBG (5, "sv600_prepare_scan: SEND LUT failed: %d\n", ret);
+    return ret;
+  }
+
+  DBG (10, "sv600_prepare_scan: finish\n");
+  return SANE_STATUS_GOOD;
+}
