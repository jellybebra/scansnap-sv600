+static int
+sv600_luminance(const unsigned char *pixel)
+{
+  return (77 * pixel[0] + 150 * pixel[1] + 29 * pixel[2]) >> 8;
+}
+
+static int
+sv600_solve_perspective(const struct sv600_point source[4],
+                        int width, int height, double result[8])
+{
+  double matrix[8][9];
+  struct sv600_point destination[4];
+  int point;
+  int column;
+  int row;
+
+  destination[0].x = 0;
+  destination[0].y = 0;
+  destination[1].x = width - 1;
+  destination[1].y = 0;
+  destination[2].x = width - 1;
+  destination[2].y = height - 1;
+  destination[3].x = 0;
+  destination[3].y = height - 1;
+  memset(matrix, 0, sizeof(matrix));
+
+  for (point = 0; point < 4; point++) {
+    double x = destination[point].x;
+    double y = destination[point].y;
+    double source_x = source[point].x;
+    double source_y = source[point].y;
+    int first = point * 2;
+    int second = first + 1;
+
+    matrix[first][0] = x;
+    matrix[first][1] = y;
+    matrix[first][2] = 1;
+    matrix[first][6] = -source_x * x;
+    matrix[first][7] = -source_x * y;
+    matrix[first][8] = source_x;
+
+    matrix[second][3] = x;
+    matrix[second][4] = y;
+    matrix[second][5] = 1;
+    matrix[second][6] = -source_y * x;
+    matrix[second][7] = -source_y * y;
+    matrix[second][8] = source_y;
+  }
+
+  for (column = 0; column < 8; column++) {
+    int pivot = column;
+    double divisor;
+
+    for (row = column + 1; row < 8; row++) {
+      if (fabs(matrix[row][column]) > fabs(matrix[pivot][column]))
+        pivot = row;
+    }
+    if (fabs(matrix[pivot][column]) < 1e-12)
+      return 0;
+
+    if (pivot != column) {
+      for (row = column; row < 9; row++) {
+        double temporary = matrix[column][row];
+        matrix[column][row] = matrix[pivot][row];
+        matrix[pivot][row] = temporary;
+      }
+    }
+
+    divisor = matrix[column][column];
+    for (row = column; row < 9; row++)
+      matrix[column][row] /= divisor;
+
+    for (row = 0; row < 8; row++) {
+      double factor;
+      int item;
+      if (row == column)
+        continue;
+      factor = matrix[row][column];
+      for (item = column; item < 9; item++)
+        matrix[row][item] -= factor * matrix[column][item];
+    }
+  }
+
+  for (row = 0; row < 8; row++)
+    result[row] = matrix[row][8];
+  return 1;
+}
