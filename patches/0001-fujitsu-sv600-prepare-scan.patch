@@ -7742,2 +7790,17 @@ set_window (struct fujitsu *s)
-  /* common to all vuids */
-  if(s->source == SOURCE_FLATBED){
+  /* The SV600 Windows minidriver's SendSWDData() emits a Comet-specific
