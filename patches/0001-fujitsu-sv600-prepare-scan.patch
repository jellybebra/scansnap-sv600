+/* A flat calibration target shows a repeatable vertical sweep distortion in
+ * the SV600 image after the projective transform.  The coefficients below
+ * were fitted to long horizontal rules across an A4 target.  Expressing both
+ * axes and the displacement in normalized coordinates makes the correction
+ * resolution-independent and suitable for the geometrically similar A3 page.
+ */
+static double
+sv600_flat_dewarp_y(int x, double y, int width, int height)
+{
+  static const double coefficients[3][2] = {
+    {-5.25319, 17.87414},
+    {-4.03829, 16.15578},
+    {10.15979, -27.12350}
+  };
+  double normalized_x = 2.0 * x / max(1, width - 1) - 1.0;
+  double normalized_y = y / (double)max(1, height - 1);
+  double x_power = normalized_x;
+  double displacement = 0;
+  int power;
+
+  for (power = 0; power < 3; power++) {
+    displacement += x_power * (coefficients[power][0]
+      + coefficients[power][1] * normalized_y);
+    x_power *= normalized_x;
+  }
+
+  return y + displacement * height / 877.0;
+}
+
+/* The red and blue SV600 images have opposite vertical scale errors relative
+ * to green.  They are nearly independent of x, but grow quadratically down
+ * the scan: about one pixel near the top and fourteen pixels at the bottom of
+ * a 300 dpi A4 page.  Register the channels before the projective sampling so
+ * correction costs no additional interpolation pass. */
+static double
+sv600_channel_registration_y(int channel, double y, int height)
+{
+  static const double coefficients[3][3] = {
+    {1.10252569215e-6, -3.75043422725e-5, 0.775689500893},
+    {0, 0, 0},
+    {-1.09427345984e-6, -1.58936027554e-5, -0.728315456674}
+  };
+  double scale = height / 3508.0;
+  double calibration_y = y / scale;
+  double displacement = (coefficients[channel][0] * calibration_y
+    + coefficients[channel][1]) * calibration_y
+    + coefficients[channel][2];
+
+  return y + displacement * scale;
+}
