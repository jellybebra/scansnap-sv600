+static unsigned char
+sv600_device_sample(const unsigned char *pixels, int stride, int y,
+                    int logical_x, int channel)
+{
+  int device_x;
+
+  if (logical_x < SV600_ACTIVE_LEFT || logical_x > SV600_ACTIVE_RIGHT)
+    return 0;
+  if (logical_x <= SV600_DEVICE_LEFT)
+    device_x = 0;
+  else if (logical_x >= SV600_DEVICE_LEFT + SV600_DEVICE_WIDTH - 1)
+    device_x = SV600_DEVICE_WIDTH - 1;
+  else
+    device_x = logical_x - SV600_DEVICE_LEFT;
+  return pixels[(size_t)y * stride + device_x * 3 + channel];
+}
+
+/* Reproduce the minidriver's logical-row expansion and exact factory 300 dpi
+ * correction map, then return the boundary produced by AfterExtractImageF. */
+static SANE_Status
+buffer_sv600_factory_remap(struct fujitsu *s, int side, int output_height)
+{
+  SANE_Parameters *params = &s->s_params;
+  const int vertical_one = 1 << 12;
+  const int horizontal_one = 1 << 19;
+  const int device_width = params->pixels_per_line;
+  const int source_width = SV600_RAW_WIDTH;
+  const int source_height = params->lines;
+  const int source_stride = params->bytes_per_line;
+  const size_t output_bytes =
+    (size_t)SV600_FACTORY_WIDTH * output_height * 3;
+  int current[5];
+  unsigned char *corrected;
+  int map_y;
+
+  DBG (10, "buffer_sv600_factory_remap: start\n");
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || device_width != SV600_DEVICE_WIDTH
+      || source_height != SV600_RAW_HEIGHT
+      || source_stride < device_width * 3
+      || (output_height != SV600_FACTORY_A3_HEIGHT
+          && output_height != SV600_FACTORY_AUTO_HEIGHT)
+      || SV600_FACTORY_TOP + output_height > SV600_FACTORY_MAP_ROWS) {
+    DBG (5, "buffer_sv600_factory_remap: unsupported source %dx%d/%d "
+         "output=%d\n", device_width, source_height, source_stride,
+         output_height);
+    return SANE_STATUS_INVAL;
+  }
+
+  corrected = malloc(output_bytes);
+  if (!corrected)
+    return SANE_STATUS_NO_MEM;
+  memcpy(current, sv600_factory_map_first, sizeof(current));
+
+  for (map_y = 0; map_y < SV600_FACTORY_TOP + output_height; map_y++) {
+    int output_y = map_y - SV600_FACTORY_TOP;
+    int channel;
+
+    if (map_y) {
+      int item;
+      for (item = 0; item < 5; item++)
+        current[item] += sv600_factory_map_deltas[map_y - 1][item];
+    }
+    if (output_y < 0)
+      continue;
+
+    for (channel = 0; channel < 3; channel++) {
+      int vertical_offset = channel == 0 ? current[0]
+        : channel == 2 ? current[1] : 0;
+      int step = current[channel + 2];
+      int y_fixed = map_y * vertical_one + vertical_offset;
+      int source_y = y_fixed >> 12;
+      int y_fraction = y_fixed & (vertical_one - 1);
+      int center = source_width / 2;
+      uint32_t x_fixed = ((uint32_t)step >> 1)
+        + (uint32_t)center * horizontal_one
+        - (horizontal_one >> 1) - (uint32_t)step * center
+        + (uint32_t)step * SV600_FACTORY_LEFT;
+      unsigned char *destination = corrected
+        + ((size_t)output_y * SV600_FACTORY_WIDTH * 3) + channel;
+      int x;
+
+      if (source_y < 0) {
+        source_y = 0;
+        y_fraction = 0;
+      }
+      else if (source_y >= source_height - 1) {
+        source_y = source_height - 1;
+        y_fraction = 0;
+      }
+
+      for (x = 0; x < SV600_FACTORY_WIDTH; x++, x_fixed += step) {
+        int source_x = x_fixed >> 19;
+        int x_fraction = x_fixed & (horizontal_one - 1);
+        int source_x_right;
+        unsigned int value;
+
+        if (source_x < 0) {
+          source_x = 0;
+          x_fraction = 0;
+        }
+        else if (source_x >= source_width - 1) {
+          source_x = source_width - 1;
+          x_fraction = 0;
+        }
+        source_x_right = source_x < source_width - 1
+          ? source_x + 1 : source_x;
+        if (!y_fraction || source_y == source_height - 1) {
+          unsigned int top_left = sv600_device_sample(
+            s->buffers[side], source_stride, source_y, source_x, channel);
+          unsigned int top_right = sv600_device_sample(
+            s->buffers[side], source_stride, source_y, source_x_right,
+            channel);
+          value = (top_left * (horizontal_one - x_fraction)
+                   + top_right * x_fraction) >> 19;
+        }
+        else {
+          int x_fraction_q12 = x_fraction >> 7;
+          unsigned int top_left = sv600_device_sample(
+            s->buffers[side], source_stride, source_y, source_x, channel);
+          unsigned int top_right = sv600_device_sample(
+            s->buffers[side], source_stride, source_y, source_x_right,
+            channel);
+          unsigned int bottom_left = sv600_device_sample(
+            s->buffers[side], source_stride, source_y + 1, source_x,
+            channel);
+          unsigned int bottom_right = sv600_device_sample(
+            s->buffers[side], source_stride, source_y + 1, source_x_right,
+            channel);
+          value = (bottom_left * (vertical_one - x_fraction_q12)
+                     * y_fraction
+                   + bottom_right * x_fraction_q12 * y_fraction
+                   + top_right * x_fraction_q12
+                     * (vertical_one - y_fraction)
+                   + top_left * (vertical_one - x_fraction_q12)
+                     * (vertical_one - y_fraction)) >> 24;
+        }
+        *destination = (unsigned char)value;
+        destination += 3;
+      }
+    }
+  }
+
+  free(s->buffers[side]);
+  s->buffers[side] = corrected;
+  s->buff_tot[side] = (int)output_bytes;
+  s->bytes_tot[side] = (int)output_bytes;
+  params->pixels_per_line = SV600_FACTORY_WIDTH;
+  params->bytes_per_line = SV600_FACTORY_WIDTH * 3;
+  params->lines = output_height;
+  update_u_params(s);
+  s->bytes_rx[side] = (int)output_bytes;
+  s->buff_rx[side] = (int)output_bytes;
+  DBG (10, "buffer_sv600_factory_remap: finish %dx%d\n",
+       SV600_FACTORY_WIDTH, output_height);
+  return SANE_STATUS_GOOD;
+}
+
+static int
+sv600_write_ppm(const char *path, const unsigned char *pixels,
+                int width, int height, int stride)
+{
+  FILE *stream = fopen(path, "wb");
+  int y;
+
+  if (!stream)
+    return 0;
+  if (fprintf(stream, "P6\n%d %d\n255\n", width, height) < 1) {
+    fclose(stream);
+    return 0;
+  }
+  for (y = 0; y < height; y++) {
+    if (fwrite(pixels + (size_t)y * stride, 1, (size_t)width * 3,
+               stream) != (size_t)width * 3) {
+      fclose(stream);
+      return 0;
+    }
+  }
+  return fclose(stream) == 0;
+}
+
+static int
+sv600_unix_to_wine_path(const char *source, char *destination, size_t size)
+{
+  size_t index;
+  size_t length = strlen(source);
+
+  if (length + 3 > size || source[0] != '/')
+    return 0;
+  destination[0] = 'Z';
+  destination[1] = ':';
+  for (index = 0; index <= length; index++)
+    destination[index + 2] = source[index] == '/' ? '\\' : source[index];
+  return 1;
+}
+
+static int
+sv600_read_ppm(const char *path, unsigned char *pixels, size_t capacity,
+               int *width, int *height)
+{
+  FILE *stream = fopen(path, "rb");
+  char line[128];
+  int maximum;
+  size_t bytes;
+
+  if (!stream)
+    return 0;
+  if (!fgets(line, sizeof(line), stream) || strcmp(line, "P6\n") != 0
+      || !fgets(line, sizeof(line), stream)
+      || sscanf(line, "%d %d", width, height) != 2
+      || !fgets(line, sizeof(line), stream)
+      || sscanf(line, "%d", &maximum) != 1 || maximum != 255
+      || *width < 1 || *height < 1) {
+    fclose(stream);
+    return 0;
+  }
+  if (*width > 20000 || *height > 20000
+      || (size_t)*width > SIZE_MAX / (size_t)*height / 3) {
+    fclose(stream);
+    return 0;
+  }
+  bytes = (size_t)*width * (size_t)*height * 3;
+  if (bytes > capacity || fread(pixels, 1, bytes, stream) != bytes) {
+    fclose(stream);
+    return 0;
+  }
+  return fclose(stream) == 0;
+}
+
+static unsigned char *
+sv600_read_ppm_alloc(const char *path, int *width, int *height)
+{
+  FILE *stream = fopen(path, "rb");
+  unsigned char *pixels = NULL;
+  char line[128];
+  int maximum;
+  size_t bytes;
+
+  if (!stream)
+    return NULL;
+  if (!fgets(line, sizeof(line), stream) || strcmp(line, "P6\n") != 0
+      || !fgets(line, sizeof(line), stream)
+      || sscanf(line, "%d %d", width, height) != 2
+      || !fgets(line, sizeof(line), stream)
+      || sscanf(line, "%d", &maximum) != 1 || maximum != 255
+      || *width < 1 || *height < 1 || *width > 20000 || *height > 20000
+      || (size_t)*width > SIZE_MAX / (size_t)*height / 3) {
+    fclose(stream);
+    return NULL;
+  }
+  bytes = (size_t)*width * (size_t)*height * 3;
+  pixels = malloc(bytes);
+  if (!pixels || fread(pixels, 1, bytes, stream) != bytes
+      || fclose(stream) != 0) {
+    free(pixels);
+    return NULL;
+  }
+  return pixels;
+}
+
+/* Run the same P2IDIGCROP and bookbound exports used by ScanSnap Home.  The
+ * executable is isolated in a Wine child process so no PE code is loaded into
+ * the SANE frontend. */
+static SANE_Status
+buffer_sv600_vendor_geometry(struct fujitsu *s, int side, int page)
+{
+  static const char helper[] =
+    "/usr/lib/scansnap-sv600/sv600-factory-pipeline.exe";
+  static const char vendor_dir[] = "/usr/lib/scansnap-sv600";
+  SANE_Parameters *params = &s->s_params;
+  char directory[] = "/tmp/scansnap-sv600-XXXXXX";
+  char input_path[sizeof(directory) + 16];
+  char output_path[sizeof(directory) + 16];
+  char wine_vendor[512];
+  char wine_input[512];
+  char wine_output[512];
+  const char *mode = page == 3 ? "a3" : page == 4 ? "a4"
+    : page == 5 ? "a5" : "detect";
+  pid_t child;
+  pid_t waited;
+  int status = 0;
+  int output_width = 0;
+  int output_height = 0;
+  size_t output_bytes;
+  SANE_Status ret = SANE_STATUS_IO_ERROR;
+
+  DBG (10, "buffer_sv600_vendor_geometry: start page=%d mode=%s\n",
+       page, mode);
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || params->pixels_per_line != SV600_FACTORY_WIDTH
+      || (page == 3 && params->lines != SV600_FACTORY_A3_HEIGHT)
+      || (page != 3 && params->lines != SV600_FACTORY_AUTO_HEIGHT)
+      || access(helper, X_OK) != 0
+      || access("/usr/lib/scansnap-sv600/P2IDIGCROP.dll", R_OK) != 0
+      || access("/usr/lib/scansnap-sv600/bookbound.dll", R_OK) != 0)
+    return SANE_STATUS_INVAL;
+  if (!mkdtemp(directory))
+    return SANE_STATUS_IO_ERROR;
+  snprintf(input_path, sizeof(input_path), "%s/input.ppm", directory);
+  snprintf(output_path, sizeof(output_path), "%s/output.ppm", directory);
+
+  if (!sv600_write_ppm(input_path, s->buffers[side],
+                       params->pixels_per_line, params->lines,
+                       params->bytes_per_line)
+      || !sv600_unix_to_wine_path(vendor_dir, wine_vendor,
+                                  sizeof(wine_vendor))
+      || !sv600_unix_to_wine_path(input_path, wine_input, sizeof(wine_input))
+      || !sv600_unix_to_wine_path(output_path, wine_output,
+                                  sizeof(wine_output)))
+    goto cleanup;
+
+  child = fork();
+  if (child == 0) {
+    if (dup2(STDERR_FILENO, STDOUT_FILENO) < 0)
+      _exit(127);
+    setenv("WINEDEBUG", "-all", 1);
+    setenv("WINEDLLOVERRIDES", "mscoree,mshtml=", 1);
+    execl("/usr/bin/wine", "wine", helper, wine_vendor, wine_input,
+          wine_output, mode, (char *)NULL);
+    _exit(127);
+  }
+  if (child < 0)
+    goto cleanup;
+  do {
+    waited = waitpid(child, &status, 0);
+  } while (waited < 0 && errno == EINTR);
+  if (waited != child || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+    DBG (5, "buffer_sv600_vendor_geometry: helper status=%d\n", status);
+    goto cleanup;
+  }
+
+  if (!sv600_read_ppm(output_path, s->buffers[side],
+                       (size_t)s->buff_tot[side],
+                       &output_width, &output_height))
+    goto cleanup;
+  output_bytes = (size_t)output_width * output_height * 3;
+  params->pixels_per_line = output_width;
+  params->bytes_per_line = output_width * 3;
+  params->lines = output_height;
+  update_u_params(s);
+  s->bytes_rx[side] = (int)output_bytes;
+  s->buff_rx[side] = (int)output_bytes;
+  ret = SANE_STATUS_GOOD;
+
+cleanup:
+  unlink(output_path);
+  unlink(input_path);
+  rmdir(directory);
+  DBG (10, "buffer_sv600_vendor_geometry: finish %dx%d ret=%d\n",
+       output_width, output_height, ret);
+  return ret;
+}
+
+/* ScanSnap Home performs output-resolution conversion after gamma, sRGB and
+ * USM.  P2IATRES supplies both the exact output-size rounding and the pixel
+ * kernel, so the replay is independent of frontend interpolation choices. */
+static SANE_Status
+buffer_sv600_vendor_resize(struct fujitsu *s, int side, int resolution)
+{
+  static const char helper[] =
+    "/usr/lib/scansnap-sv600/sv600-factory-resize.exe";
+  static const char vendor_dir[] = "/usr/lib/scansnap-sv600";
+  SANE_Parameters *params = &s->s_params;
+  char directory[] = "/tmp/scansnap-sv600-resize-XXXXXX";
+  char input_path[sizeof(directory) + 16];
+  char output_path[sizeof(directory) + 16];
+  char wine_vendor[512];
+  char wine_input[512];
+  char wine_output[512];
+  char resolution_text[16];
+  unsigned char *resized = NULL;
+  int source_width = params->pixels_per_line;
+  int source_height = params->lines;
+  int output_width = 0;
+  int output_height = 0;
+  size_t output_bytes;
+  pid_t child;
+  pid_t waited;
+  int status = 0;
+  SANE_Status ret = SANE_STATUS_IO_ERROR;
+
+  DBG (10, "buffer_sv600_vendor_resize: start %dx%d %d dpi\n",
+       source_width, source_height, resolution);
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || params->bytes_per_line != source_width * 3
+      || (resolution != 150 && resolution != 200 && resolution != 600)
+      || access(helper, X_OK) != 0
+      || access("/usr/lib/scansnap-sv600/P2IATRES.DLL", R_OK) != 0
+      || access("/usr/lib/scansnap-sv600/i3ipCore/I3ipShare.dll", R_OK) != 0
+      || access("/usr/lib/scansnap-sv600/i3ipCore/I3ipCommon.dll", R_OK) != 0)
+    return SANE_STATUS_INVAL;
+  if (!mkdtemp(directory))
+    return SANE_STATUS_IO_ERROR;
+  snprintf(input_path, sizeof(input_path), "%s/input.ppm", directory);
+  snprintf(output_path, sizeof(output_path), "%s/output.ppm", directory);
+  snprintf(resolution_text, sizeof(resolution_text), "%d", resolution);
+
+  if (!sv600_write_ppm(input_path, s->buffers[side], source_width,
+                       source_height, params->bytes_per_line)
+      || !sv600_unix_to_wine_path(vendor_dir, wine_vendor,
+                                  sizeof(wine_vendor))
+      || !sv600_unix_to_wine_path(input_path, wine_input, sizeof(wine_input))
+      || !sv600_unix_to_wine_path(output_path, wine_output,
+                                  sizeof(wine_output)))
+    goto cleanup;
+
+  child = fork();
+  if (child == 0) {
+    if (dup2(STDERR_FILENO, STDOUT_FILENO) < 0)
+      _exit(127);
+    setenv("WINEDEBUG", "-all", 1);
+    setenv("WINEDLLOVERRIDES", "mscoree,mshtml=", 1);
+    execl("/usr/bin/wine", "wine", helper, wine_vendor, wine_input,
+          wine_output, resolution_text, (char *)NULL);
+    _exit(127);
+  }
+  if (child < 0)
+    goto cleanup;
+  do {
+    waited = waitpid(child, &status, 0);
+  } while (waited < 0 && errno == EINTR);
+  if (waited != child || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+    DBG (5, "buffer_sv600_vendor_resize: helper status=%d\n", status);
+    goto cleanup;
+  }
+
+  resized = sv600_read_ppm_alloc(output_path, &output_width, &output_height);
+  if (!resized
+      || output_width != source_width * resolution / 300
+      || output_height != source_height * resolution / 300)
+    goto cleanup;
+  output_bytes = (size_t)output_width * (size_t)output_height * 3;
+  if (output_bytes > INT_MAX)
+    goto cleanup;
+
+  free(s->buffers[side]);
+  s->buffers[side] = resized;
+  resized = NULL;
+  s->buff_tot[side] = (int)output_bytes;
+  s->bytes_tot[side] = (int)output_bytes;
+  params->pixels_per_line = output_width;
+  params->bytes_per_line = output_width * 3;
+  params->lines = output_height;
+  update_u_params(s);
+  s->bytes_rx[side] = (int)output_bytes;
+  s->buff_rx[side] = (int)output_bytes;
+  ret = SANE_STATUS_GOOD;
+
+cleanup:
+  free(resized);
+  unlink(output_path);
+  unlink(input_path);
+  rmdir(directory);
+  DBG (10, "buffer_sv600_vendor_resize: finish %dx%d ret=%d\n",
+       output_width, output_height, ret);
+  return ret;
+}
+
+static SANE_Status
+buffer_sv600_rotate_portrait(struct fujitsu *s, int side)
+{
+  SANE_Parameters *params = &s->s_params;
+  int old_width = params->pixels_per_line;
+  int old_height = params->lines;
+  size_t bytes = (size_t)old_width * old_height * 3;
+  unsigned char *rotated;
+  int y;
+
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || params->bytes_per_line != old_width * 3
+      || bytes > (size_t)s->buff_tot[side])
+    return SANE_STATUS_INVAL;
+  rotated = malloc(bytes);
+  if (!rotated)
+    return SANE_STATUS_NO_MEM;
+  for (y = 0; y < old_height; y++) {
+    int x;
+    for (x = 0; x < old_width; x++)
+      memcpy(rotated + ((size_t)(old_width - 1 - x) * old_height + y) * 3,
+             s->buffers[side] + ((size_t)y * old_width + x) * 3, 3);
+  }
+  memcpy(s->buffers[side], rotated, bytes);
+  free(rotated);
+  params->pixels_per_line = old_height;
+  params->bytes_per_line = old_height * 3;
+  params->lines = old_width;
+  update_u_params(s);
+  s->bytes_rx[side] = (int)bytes;
+  s->buff_rx[side] = (int)bytes;
+  return SANE_STATUS_GOOD;
+}
+
+/* Reproduce the late ScanSnap Home document-color chain. */
+static unsigned char
+sv600_srgb_interpolate(int red, int green, int blue, int channel)
+{
+  int red_cell = red >> 4;
+  int green_cell = green >> 4;
+  int blue_cell = blue >> 4;
+  int red_fraction = red & 15;
+  int green_fraction = green & 15;
+  int blue_fraction = blue & 15;
+  int red_inverse = 16 - red_fraction;
+  int green_inverse = 16 - green_fraction;
+  int blue_inverse = 16 - blue_fraction;
+  size_t base = (((size_t)red_cell * 17 + green_cell) * 17
+                 + blue_cell) * 3 + channel;
+  const size_t red_step = 17 * 17 * 3;
+  const size_t green_step = 17 * 3;
+  const size_t blue_step = 3;
+  int lower_left;
+  int lower_right;
+  int upper_left;
+  int upper_right;
+  int lower;
+  int upper;
+
+  lower_left = (sv600_srgb_grid[base] * red_inverse
+                + sv600_srgb_grid[base + red_step] * red_fraction) >> 4;
+  lower_right = (sv600_srgb_grid[base + green_step] * red_inverse
+                 + sv600_srgb_grid[base + red_step + green_step]
+                   * red_fraction) >> 4;
+  lower = (lower_left * green_inverse
+           + lower_right * green_fraction) >> 4;
+
+  upper_left = (sv600_srgb_grid[base + blue_step] * red_inverse
+                + sv600_srgb_grid[base + red_step + blue_step]
+                  * red_fraction) >> 4;
+  upper_right =
+    (sv600_srgb_grid[base + green_step + blue_step] * red_inverse
+     + sv600_srgb_grid[base + red_step + green_step + blue_step]
+       * red_fraction) >> 4;
+  upper = (upper_left * green_inverse
+           + upper_right * green_fraction) >> 4;
+  return (unsigned char)((lower * blue_inverse
+                          + upper * blue_fraction) >> 4);
+}
+
+static SANE_Status
+buffer_sv600_factory_gamma(struct fujitsu *s, int side)
+{
+  SANE_Parameters *params = &s->s_params;
+  int width = params->pixels_per_line;
+  int height = params->lines;
+  int stride = params->bytes_per_line;
+  size_t bytes = (size_t)stride * height;
+  unsigned char *pixels = s->buffers[side];
+  int y;
+
+  DBG (10, "buffer_sv600_factory_gamma: start %dx%d\n", width, height);
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || width < 1 || height < 1 || stride < width * 3
+      || bytes > (size_t)s->buff_tot[side])
+    return SANE_STATUS_INVAL;
+
+  for (y = 0; y < height; y++) {
+    unsigned char *pixel = pixels + (size_t)y * stride;
+    int x;
+    for (x = 0; x < width; x++, pixel += 3) {
+      pixel[0] = sv600_gamma_10_to_18[pixel[0]];
+      pixel[1] = sv600_gamma_10_to_18[pixel[1]];
+      pixel[2] = sv600_gamma_10_to_18[pixel[2]];
+    }
+  }
+  DBG (10, "buffer_sv600_factory_gamma: finish\n");
+  return SANE_STATUS_GOOD;
+}
+
+/* After output-resolution conversion, ScanSnap Home interpolates the SV600
+ * 17^3 RGB control grid with an integer shift after each axis, then runs
+ * SsSvcDoUSM2.  The SV600 entry selects strength 50; PfuSsSvcHelper uses a
+ * radius-two 3/4 kernel and a soft threshold of eight. */
+static SANE_Status
+buffer_sv600_factory_finish(struct fujitsu *s, int side)
+{
+  SANE_Parameters *params = &s->s_params;
+  int width = params->pixels_per_line;
+  int height = params->lines;
+  int stride = params->bytes_per_line;
+  size_t bytes = (size_t)stride * height;
+  unsigned char *pixels = s->buffers[side];
+  unsigned char *sharpened;
+  int y;
+
+  DBG (10, "buffer_sv600_factory_finish: start %dx%d\n", width, height);
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || width < 1 || height < 1 || stride < width * 3
+      || bytes > (size_t)s->buff_tot[side])
+    return SANE_STATUS_INVAL;
+
+  for (y = 0; y < height; y++) {
+    unsigned char *pixel = pixels + (size_t)y * stride;
+    int x;
+    for (x = 0; x < width; x++, pixel += 3) {
+      int red = pixel[0];
+      int green = pixel[1];
+      int blue = pixel[2];
+      pixel[0] = sv600_srgb_interpolate(red, green, blue, 0);
+      pixel[1] = sv600_srgb_interpolate(red, green, blue, 1);
+      pixel[2] = sv600_srgb_interpolate(red, green, blue, 2);
+    }
+  }
+
+  sharpened = malloc(bytes);
+  if (!sharpened)
+    return SANE_STATUS_NO_MEM;
+  memcpy(sharpened, pixels, bytes);
+
+  for (y = 2; y < height - 2; y++) {
+    int x;
+    for (x = 2; x < width - 2; x++) {
+      int channel;
+      for (channel = 0; channel < 3; channel++) {
+        size_t center_offset = (size_t)y * stride + x * 3 + channel;
+        int center = pixels[center_offset];
+        int sum = 3 *
+          (pixels[(size_t)(y - 2) * stride + (x - 2) * 3 + channel]
+           + pixels[(size_t)(y - 2) * stride + (x + 2) * 3 + channel]
+           + pixels[(size_t)(y + 2) * stride + (x - 2) * 3 + channel]
+           + pixels[(size_t)(y + 2) * stride + (x + 2) * 3 + channel])
+          + 4 *
+          (pixels[(size_t)(y - 2) * stride + x * 3 + channel]
+           + pixels[(size_t)y * stride + (x - 2) * 3 + channel]
+           + center
+           + pixels[(size_t)y * stride + (x + 2) * 3 + channel]
+           + pixels[(size_t)(y + 2) * stride + x * 3 + channel]);
+        int delta = center - (sum >> 5);
+        int magnitude = delta < 0 ? -delta : delta;
+        if (magnitude >= 8) {
+          int correction = (magnitude - 7) / 2;
+          int value = center + (delta < 0 ? -correction : correction);
+          if (value < 0)
+            value = 0;
+          else if (value > 255)
+            value = 255;
+          sharpened[center_offset] = (unsigned char)value;
+        }
+      }
+    }
+  }
+
+  memcpy(pixels, sharpened, bytes);
+  free(sharpened);
+  DBG (10, "buffer_sv600_factory_finish: finish\n");
+  return SANE_STATUS_GOOD;
+}
+
+/* SANE's packed 1-bit path requires a whole number of pixels per byte.  The
+ * factory fixed-size RGB dimensions are sometimes odd, so remove at most the
+ * seven rightmost pixels before the generic RGB-to-Lineart conversion. */
+static SANE_Status
+buffer_sv600_align_binary_width(struct fujitsu *s, int side)
+{
+  SANE_Parameters *params = &s->s_params;
+  int old_width = params->pixels_per_line;
+  int new_width = old_width - old_width % 8;
+  int old_stride = params->bytes_per_line;
+  int new_stride = new_width * 3;
+  size_t output_bytes;
+  int y;
+
+  if (new_width == old_width)
+    return SANE_STATUS_GOOD;
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || new_width < 8 || old_stride < old_width * 3)
+    return SANE_STATUS_INVAL;
+
+  for (y = 1; y < params->lines; y++)
+    memmove(s->buffers[side] + (size_t)y * new_stride,
+            s->buffers[side] + (size_t)y * old_stride,
+            (size_t)new_stride);
+
+  output_bytes = (size_t)new_stride * params->lines;
+  params->pixels_per_line = new_width;
+  params->bytes_per_line = new_stride;
+  update_u_params(s);
+  s->bytes_rx[side] = (int)output_bytes;
+  s->buff_rx[side] = (int)output_bytes;
+  DBG (10, "buffer_sv600_align_binary_width: %d -> %d\n",
+       old_width, new_width);
+  return SANE_STATUS_GOOD;
+}
