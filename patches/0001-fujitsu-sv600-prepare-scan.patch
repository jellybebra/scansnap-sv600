+/* Apply the exact factory 300 dpi correction map used by SV600u-x64.dll.
+ * The original manual kernel stores vertical coordinates in Q12 and the
+ * centre-based horizontal sampling step in Q19.  Each channel is remapped
+ * independently with bilinear interpolation.  Automatic detection uses the
+ * observed 2781-line A4 boundary; fixed flat formats keep the full A3 field. */
+static SANE_Status
+buffer_sv600_factory_remap(struct fujitsu *s, int side, int output_height)
+{
+  SANE_Parameters *params = &s->s_params;
+  const int vertical_one = 1 << 12;
+  const int horizontal_one = 1 << 19;
+  int current[5];
+  int source_width = params->pixels_per_line;
+  int source_height = params->lines;
+  int source_stride = params->bytes_per_line;
+  size_t output_bytes = (size_t)source_width * output_height * 3;
+  unsigned char *corrected;
+  int y;
+
+  DBG (10, "buffer_sv600_factory_remap: start\n");
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || source_stride < source_width * 3
+      || output_height < 1 || output_height > SV600_FACTORY_MAP_ROWS
+      || source_height < output_height
+      || output_bytes > (size_t)s->buff_tot[side]) {
+    DBG (5, "buffer_sv600_factory_remap: unsupported source %dx%d/%d\n",
+         source_width, source_height, source_stride);
+    return SANE_STATUS_INVAL;
+  }
+
+  corrected = malloc(output_bytes);
+  if (!corrected) {
+    DBG (5, "buffer_sv600_factory_remap: cannot allocate output\n");
+    return SANE_STATUS_NO_MEM;
+  }
+  memcpy(current, sv600_factory_map_first, sizeof(current));
+
+  for (y = 0; y < output_height; y++) {
+    int channel;
+    if (y) {
+      int item;
+      for (item = 0; item < 5; item++)
+        current[item] += sv600_factory_map_deltas[y - 1][item];
+    }
+
+    for (channel = 0; channel < 3; channel++) {
+      int vertical_offset = channel == 0 ? current[0]
+        : channel == 2 ? current[1] : 0;
+      int step = current[channel + 2];
+      int y_fixed = y * vertical_one + vertical_offset;
+      int source_y = y_fixed >> 12;
+      int y_fraction = y_fixed & (vertical_one - 1);
+      int center = source_width / 2;
+      /* The original kernel uses a uint accumulator.  The last quarter of a
+       * 5104-pixel line exceeds INT_MAX even though it remains well within
+       * UINT32_MAX; a signed accumulator wrapped there and sampled the dark
+       * opposite edge over the physical upper-left corner of a portrait A4. */
+      uint32_t x_fixed = ((uint32_t)step >> 1)
+        + (uint32_t)center * horizontal_one
+        - (horizontal_one >> 1) - (uint32_t)step * center;
+      unsigned char *destination = corrected
+        + ((size_t)y * source_width * 3) + channel;
+      int x;
+
+      if (source_y < 0) {
+        source_y = 0;
+        y_fraction = 0;
+      }
+      else if (source_y >= source_height - 1) {
+        source_y = source_height - 1;
+        y_fraction = 0;
+      }
+
+      for (x = 0; x < source_width; x++, x_fixed += step) {
+        int source_x = x_fixed >> 19;
+        int x_fraction = x_fixed & (horizontal_one - 1);
+        const unsigned char *top;
+        unsigned int value;
+
+        if (source_x < 0) {
+          source_x = 0;
+          x_fraction = 0;
+        }
+        else if (source_x >= source_width - 1) {
+          source_x = source_width - 1;
+          x_fraction = 0;
+        }
+        top = s->buffers[side] + (size_t)source_y * source_stride
+          + source_x * 3 + channel;
+
+        if (!y_fraction || source_y == source_height - 1) {
+          value = ((unsigned int)top[0] * (horizontal_one - x_fraction)
+                   + (unsigned int)top[source_x < source_width - 1 ? 3 : 0]
+                     * x_fraction) >> 19;
+        }
+        else {
+          const unsigned char *bottom = top + source_stride;
+          int x_fraction_q12 = x_fraction >> 7;
+          unsigned int top_left = top[0];
+          unsigned int top_right = top[source_x < source_width - 1 ? 3 : 0];
+          unsigned int bottom_left = bottom[0];
+          unsigned int bottom_right =
+            bottom[source_x < source_width - 1 ? 3 : 0];
+          value = (bottom_left * (vertical_one - x_fraction_q12)
+                     * y_fraction
+                   + bottom_right * x_fraction_q12 * y_fraction
+                   + top_right * x_fraction_q12
+                     * (vertical_one - y_fraction)
+                   + top_left * (vertical_one - x_fraction_q12)
+                     * (vertical_one - y_fraction)) >> 24;
+        }
+        *destination = (unsigned char)value;
+        destination += 3;
+      }
+    }
+  }
+
+  memcpy(s->buffers[side], corrected, output_bytes);
+  free(corrected);
+  params->lines = output_height;
+  params->bytes_per_line = source_width * 3;
+  update_u_params(s);
+  s->bytes_rx[side] = (int)output_bytes;
+  s->buff_rx[side] = (int)output_bytes;
+  DBG (10, "buffer_sv600_factory_remap: finish %dx%d\n",
+       source_width, output_height);
+  return SANE_STATUS_GOOD;
+}
+
+/* Locate the first short run of paper-coloured pixels along one line. */
+static int
+sv600_find_page_edge(const unsigned char *image, int width, int height,
+                     int horizontal, int coordinate, int reverse,
+                     int maximum_depth, int threshold, int run_length)
+{
+  int bright = 0;
+  int depth;
+
+  for (depth = 0; depth < maximum_depth; depth++) {
+    int position = reverse ? (horizontal ? width : height) - 1 - depth
+      : depth;
+    int x = horizontal ? position : coordinate;
+    int y = horizontal ? coordinate : position;
+    const unsigned char *pixel = image + ((size_t)y * width + x) * 3;
+
+    if (sv600_luminance(pixel) >= threshold)
+      bright++;
+    else
+      bright = 0;
+    if (bright >= run_length)
+      return depth - run_length + 1;
+  }
+  return -1;
+}
+
+/* Whiten only the area before the first stable paper run on each border-normal
+ * scanline.  Unlike a connected dark-pixel flood fill, this cannot follow a
+ * pencil stroke from the sheet edge into the document.  Pixel dimensions and
+ * content are unchanged. */
+static void
+sv600_whiten_outside_page(unsigned char *image, int width, int height,
+                          int threshold)
+{
+  int maximum_depth = min(width, height) / 12;
+  const int run_length = 8;
+  unsigned long whitened = 0;
+  int pass;
+  int x;
+  int y;
+
+  /* A second pass lets the already-whitened horizontal/vertical strips close
+   * tiny dark corner islands without treating them as document content. */
+  for (pass = 0; pass < 2; pass++) {
+    for (x = 0; x < width; x++) {
+      int reverse;
+      for (reverse = 0; reverse < 2; reverse++) {
+        int depth = sv600_find_page_edge(
+          image, width, height, 0, x, reverse,
+          maximum_depth, threshold, run_length);
+        int offset;
+        if (depth < 0)
+          continue;
+        for (offset = 0; offset < depth; offset++) {
+          int page_y = reverse ? height - 1 - offset : offset;
+          unsigned char *pixel = image
+            + ((size_t)page_y * width + x) * 3;
+          if (pixel[0] != 255 || pixel[1] != 255 || pixel[2] != 255) {
+            pixel[0] = pixel[1] = pixel[2] = 255;
+            whitened++;
+          }
+        }
+      }
+    }
+    for (y = 0; y < height; y++) {
+      int reverse;
+      for (reverse = 0; reverse < 2; reverse++) {
+        int depth = sv600_find_page_edge(
+          image, width, height, 1, y, reverse,
+          maximum_depth, threshold, run_length);
+        int offset;
+        if (depth < 0)
+          continue;
+        for (offset = 0; offset < depth; offset++) {
+          int page_x = reverse ? width - 1 - offset : offset;
+          unsigned char *pixel = image
+            + ((size_t)y * width + page_x) * 3;
+          if (pixel[0] != 255 || pixel[1] != 255 || pixel[2] != 255) {
+            pixel[0] = pixel[1] = pixel[2] = 255;
+            whitened++;
+          }
+        }
+      }
+    }
+  }
+  DBG (15, "sv600_whiten_outside_page: whitened %lu pixels\n", whitened);
+}
+
+/* The fixed Flat profiles in ScanSnap Home use a direct physical crop after
+ * the dense optical remap.  Feature matching of the paired Windows boundary
+ * and final A4 gives boundary x=1179, y=77, width=3508, height=2479.  Linux's
+ * 5104-pixel corrected field is the centred content of that 5816-pixel
+ * boundary, so the same A4 origin is x=823, y=77 (25 pixels to the right of a
+ * centred crop).  No second homography or safety inset is applied. */
+static SANE_Status
+buffer_sv600_fixed_flat(struct fujitsu *s, int side, int page,
+                        int requested_portrait)
+{
+  SANE_Parameters *params = &s->s_params;
+  const int canvas_width = 4961;
+  const int canvas_height = 3506;
+  int source_width = params->pixels_per_line;
+  int source_height = params->lines;
+  int source_stride = params->bytes_per_line;
+  int landscape_width;
+  int landscape_height;
+  int source_left;
+  int source_top;
+  int output_width;
+  int output_height;
+  size_t output_bytes;
+  unsigned char *corrected;
+  int y;
+
+  if (page == 3) {
+    landscape_width = 4961;
+    landscape_height = 3506;
+    source_left = (source_width - canvas_width) / 2;
+    source_top = source_height - canvas_height;
+  }
+  else if (page == 4) {
+    landscape_width = 3508;
+    landscape_height = 2479;
+    source_left = (source_width - landscape_width) / 2 + 25;
+    source_top = 77;
+  }
+  else if (page == 5) {
+    landscape_width = 2481;
+    landscape_height = 1747;
+    source_left = (source_width - landscape_width) / 2 + 25;
+    source_top = 77;
+  }
+  else
+    return SANE_STATUS_INVAL;
+  output_width = requested_portrait ? landscape_height : landscape_width;
+  output_height = requested_portrait ? landscape_width : landscape_height;
+  output_bytes = (size_t)landscape_width * landscape_height * 3;
+
+  DBG (10, "buffer_sv600_fixed_flat: start page=%d output=%dx%d\n",
+       page, output_width, output_height);
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      /* Binary emulation rounds the internal color width down to a multiple
+       * of eight (5096 instead of 5104).  Centre the same factory canvas in
+       * either raw width; output dimensions remain identical. */
+      || source_width < canvas_width
+      || source_height != SV600_FACTORY_A3_ROWS
+      || source_stride < source_width * 3
+      || source_left < 0 || source_top < 0
+      || source_left + landscape_width > source_width
+      || source_top + landscape_height > source_height
+      || output_bytes > (size_t)s->buff_tot[side])
+    return SANE_STATUS_INVAL;
+
+  corrected = malloc(output_bytes);
+  if (!corrected)
+    return SANE_STATUS_NO_MEM;
+
+  for (y = 0; y < landscape_height; y++)
+    memcpy(corrected + (size_t)y * landscape_width * 3,
+           s->buffers[side] + (size_t)(source_top + y) * source_stride
+             + source_left * 3,
+           (size_t)landscape_width * 3);
+
+  if (page == 4 || page == 5)
+    sv600_whiten_outside_page(corrected, landscape_width,
+                              landscape_height, 120);
+
+  if (requested_portrait) {
+    for (y = 0; y < landscape_height; y++) {
+      int x;
+      for (x = 0; x < landscape_width; x++) {
+        const unsigned char *source = corrected
+          + ((size_t)y * landscape_width + x) * 3;
+        unsigned char *destination = s->buffers[side]
+          + ((size_t)(landscape_width - 1 - x) * landscape_height + y) * 3;
+        memcpy(destination, source, 3);
+      }
+    }
+  }
+  else
+    memcpy(s->buffers[side], corrected, output_bytes);
+  free(corrected);
+
+  params->pixels_per_line = output_width;
+  params->bytes_per_line = output_width * 3;
+  params->lines = output_height;
+  update_u_params(s);
+  s->bytes_rx[side] = (int)output_bytes;
+  s->buff_rx[side] = (int)output_bytes;
+  DBG (10, "buffer_sv600_fixed_flat: finish\n");
+  return SANE_STATUS_GOOD;
+}
+
+/* SANE's packed 1-bit path requires a whole number of pixels per byte.  The
+ * factory fixed-size RGB dimensions are sometimes odd, so remove at most the
+ * seven rightmost pixels before the generic RGB-to-Lineart conversion. */
+static SANE_Status
+buffer_sv600_align_binary_width(struct fujitsu *s, int side)
+{
+  SANE_Parameters *params = &s->s_params;
+  int old_width = params->pixels_per_line;
+  int new_width = old_width - old_width % 8;
+  int old_stride = params->bytes_per_line;
+  int new_stride = new_width * 3;
+  size_t output_bytes;
+  int y;
+
+  if (new_width == old_width)
+    return SANE_STATUS_GOOD;
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || new_width < 8 || old_stride < old_width * 3)
+    return SANE_STATUS_INVAL;
+
+  for (y = 1; y < params->lines; y++)
+    memmove(s->buffers[side] + (size_t)y * new_stride,
+            s->buffers[side] + (size_t)y * old_stride,
+            (size_t)new_stride);
+
+  output_bytes = (size_t)new_stride * params->lines;
+  params->pixels_per_line = new_width;
+  params->bytes_per_line = new_stride;
+  update_u_params(s);
+  s->bytes_rx[side] = (int)output_bytes;
+  s->buff_rx[side] = (int)output_bytes;
+  DBG (10, "buffer_sv600_align_binary_width: %d -> %d\n",
+       old_width, new_width);
+  return SANE_STATUS_GOOD;
+}
+
+/* Render directly from the scanner buffer.  Crop coordinates are expressed
+ * in the first rectified image, but are folded into this source mapping so the
+ * final page still receives only one interpolation pass. */
+static void
+sv600_render_perspective(struct fujitsu *s, int side,
+                         unsigned char *corrected,
+                         int source_width, int source_height,
+                         int output_width, int output_height,
+                         int output_portrait, const double coefficients[8],
+                         int crop_left, int crop_top,
+                         int crop_right, int crop_bottom)
+{
+  SANE_Parameters *params = &s->s_params;
+  double horizontal_span = output_width - 1 - crop_left - crop_right;
+  double vertical_span = output_height - 1 - crop_top - crop_bottom;
+  int y;
+
+  (void)output_portrait;
+
+  for (y = 0; y < output_height; y++) {
+    double target_y = crop_top + y * vertical_span
+      / max(1, output_height - 1);
+    int x;
+    for (x = 0; x < output_width; x++) {
+      double target_x = crop_left + x * horizontal_span
+        / max(1, output_width - 1);
+      double rectified_x = target_x;
+      double rectified_y = target_y;
+      double source_x[3];
+      double source_y[3];
+      unsigned char *output = corrected
+        + ((size_t)y * output_width + x) * 3;
+      int valid = 1;
+      int channel;
+
+      for (channel = 0; channel < 3; channel++) {
+        double channel_y = rectified_y;
+        {
+          double denominator = coefficients[6] * rectified_x
+            + coefficients[7] * channel_y + 1;
+          source_x[channel] = (coefficients[0] * rectified_x
+                               + coefficients[1] * channel_y
+                               + coefficients[2]) / denominator;
+          source_y[channel] = (coefficients[3] * rectified_x
+                               + coefficients[4] * channel_y
+                               + coefficients[5]) / denominator;
+        }
+        if (source_x[channel] < 0 || source_y[channel] < 0
+            || source_x[channel] > source_width - 1
+            || source_y[channel] > source_height - 1)
+          valid = 0;
+      }
+
+      if (!valid) {
+        output[0] = output[1] = output[2] = 255;
+      }
+      else {
+        for (channel = 0; channel < 3; channel++) {
+          int x0 = (int)source_x[channel];
+          int y0 = (int)source_y[channel];
+          int x1 = min(x0 + 1, source_width - 1);
+          int y1 = min(y0 + 1, source_height - 1);
+          double dx = source_x[channel] - x0;
+          double dy = source_y[channel] - y0;
+          const unsigned char *top_left = s->buffers[side]
+            + (size_t)y0 * params->bytes_per_line + x0 * 3;
+          const unsigned char *top_right = s->buffers[side]
+            + (size_t)y0 * params->bytes_per_line + x1 * 3;
+          const unsigned char *bottom_left = s->buffers[side]
+            + (size_t)y1 * params->bytes_per_line + x0 * 3;
+          const unsigned char *bottom_right = s->buffers[side]
+            + (size_t)y1 * params->bytes_per_line + x1 * 3;
+          double top = top_left[channel] * (1 - dx)
+            + top_right[channel] * dx;
+          double bottom = bottom_left[channel] * (1 - dx)
+            + bottom_right[channel] * dx;
+          output[channel] = (unsigned char)(top * (1 - dy)
+                                             + bottom * dy + 0.5);
+        }
+      }
+    }
+  }
+}
+
+static int
+sv600_line_luminance_percentile(const unsigned char *image,
+                                int width, int height,
+                                int horizontal, int coordinate,
+                                int start, int end, int percentile)
+{
+  unsigned long histogram[256];
+  unsigned long count = 0;
+  unsigned long target;
+  unsigned long cumulative = 0;
+  int position;
+
+  memset(histogram, 0, sizeof(histogram));
+  for (position = start; position < end; position++) {
+    int x = horizontal ? position : coordinate;
+    int y = horizontal ? coordinate : position;
+    const unsigned char *pixel;
+
+    if (x < 0 || x >= width || y < 0 || y >= height)
+      continue;
+    pixel = image + ((size_t)y * width + x) * 3;
+    histogram[sv600_luminance(pixel)]++;
+    count++;
+  }
+  if (!count)
+    return 255;
+
+  target = (count * percentile + 99) / 100;
+  for (position = 0; position < 256; position++) {
+    cumulative += histogram[position];
+    if (cumulative >= target)
+      return position;
+  }
+  return 255;
+}
+
+/* Find dark pixels that are eight-connected to one requested image edge.
+ * Restrict the flood fill to a narrow band: interior text must not influence
+ * document cropping even when it is very dark. */
+static int
+sv600_connected_border_depth(const unsigned char *image,
+                             int width, int height, int side,
+                             int maximum_depth, int threshold)
+{
+  int band_width = side < 2 ? width : maximum_depth + 1;
+  int band_height = side < 2 ? maximum_depth + 1 : height;
+  int band_size = band_width * band_height;
+  unsigned char *mask = NULL;
+  int *queue = NULL;
+  int head = 0;
+  int tail = 0;
+  int deepest = -1;
+  int band_y;
+
+  if (maximum_depth < 0 || band_width < 1 || band_height < 1)
+    return -1;
+  mask = malloc((size_t)band_size);
+  queue = malloc((size_t)band_size * sizeof(*queue));
+  if (!mask || !queue) {
+    DBG (5, "sv600_connected_border_depth: cannot allocate edge buffers\n");
+    free(queue);
+    free(mask);
+    return -1;
+  }
+
+  for (band_y = 0; band_y < band_height; band_y++) {
+    int band_x;
+    for (band_x = 0; band_x < band_width; band_x++) {
+      int distance = side < 2 ? band_y : band_x;
+      int x = side < 2 ? band_x
+        : side == 2 ? distance : width - 1 - distance;
+      int y = side < 2
+        ? side == 0 ? distance : height - 1 - distance
+        : band_y;
+      const unsigned char *pixel = image
+        + ((size_t)y * width + x) * 3;
+      mask[band_y * band_width + band_x]
+        = sv600_luminance(pixel) < threshold ? 1 : 0;
+    }
+  }
+
+  if (side < 2) {
+    int x;
+    for (x = 0; x < band_width; x++) {
+      if (mask[x] == 1) {
+        mask[x] = 2;
+        queue[tail++] = x;
+      }
+    }
+  }
+  else {
+    int y;
+    for (y = 0; y < band_height; y++) {
+      int position = y * band_width;
+      if (mask[position] == 1) {
+        mask[position] = 2;
+        queue[tail++] = position;
+      }
+    }
+  }
+
+  while (head < tail) {
+    int position = queue[head++];
+    int band_x = position % band_width;
+    int current_y = position / band_width;
+    int distance = side < 2 ? current_y : band_x;
+    int offset_y;
+
+    deepest = max(deepest, distance);
+    for (offset_y = -1; offset_y <= 1; offset_y++) {
+      int neighbour_y = current_y + offset_y;
+      int offset_x;
+      if (neighbour_y < 0 || neighbour_y >= band_height)
+        continue;
+      for (offset_x = -1; offset_x <= 1; offset_x++) {
+        int neighbour_x = band_x + offset_x;
+        int neighbour;
+        if ((!offset_x && !offset_y)
+            || neighbour_x < 0 || neighbour_x >= band_width)
+          continue;
+        neighbour = neighbour_y * band_width + neighbour_x;
+        if (mask[neighbour] == 1) {
+          mask[neighbour] = 2;
+          queue[tail++] = neighbour;
+        }
+      }
+    }
+  }
+
+  free(queue);
+  free(mask);
+  return deepest;
+}
+
+/* Measure each edge against nearby clean paper rather than reserving a fixed
+ * white frame.  The twentieth percentile notices a broad table/shadow strip
+ * but ignores ordinary sparse text.  A second, darker threshold flood-fills
+ * pixels connected to the outer boundary, catching hairlines and corner
+ * wedges that occupy too little of a row for the percentile to notice.  Only
+ * affected sides receive the one-millimetre print-safety allowance.
+ */
+static void
+sv600_detect_clean_crop(const unsigned char *image, int width, int height,
+                        int safety_x, int safety_y,
+                        int *crop_left, int *crop_top,
+                        int *crop_right, int *crop_bottom)
+{
+  int maximum_crop = max(2, min(width, height) / 25);
+  int horizontal_start = width / 20;
+  int horizontal_end = width - horizontal_start;
+  int vertical_start = height / 20;
+  int vertical_end = height - vertical_start;
+  int *crops[4] = {crop_top, crop_bottom, crop_left, crop_right};
+  int connected_depths[4] = {-1, -1, -1, -1};
+  int side;
+
+  *crop_left = *crop_top = *crop_right = *crop_bottom = 0;
+  for (side = 0; side < 4; side++) {
+    int reference = 0;
+    int threshold;
+    int dark_threshold;
+    int safety;
+    int distance;
+
+    for (distance = maximum_crop * 3 / 4;
+         distance <= maximum_crop; distance++) {
+      int horizontal = side < 2;
+      int coordinate;
+      int brightness;
+
+      if (side == 0)
+        coordinate = distance;
+      else if (side == 1)
+        coordinate = height - 1 - distance;
+      else if (side == 2)
+        coordinate = distance;
+      else
+        coordinate = width - 1 - distance;
+      brightness = sv600_line_luminance_percentile(
+        image, width, height, horizontal, coordinate,
+        horizontal ? horizontal_start : vertical_start,
+        horizontal ? horizontal_end : vertical_end, 20);
+      reference = max(reference, brightness);
+    }
+
+    threshold = max(0, reference - 12);
+    dark_threshold = max(64, min(160, reference - 32));
+    safety = side < 2 ? safety_y : safety_x;
+    safety = max(1, min(maximum_crop - 1, safety));
+    connected_depths[side] = sv600_connected_border_depth(
+      image, width, height, side, maximum_crop - safety,
+      dark_threshold);
+    for (distance = 0; distance <= maximum_crop; distance++) {
+      int horizontal = side < 2;
+      int coordinate;
+      int brightness;
+
+      if (side == 0)
+        coordinate = distance;
+      else if (side == 1)
+        coordinate = height - 1 - distance;
+      else if (side == 2)
+        coordinate = distance;
+      else
+        coordinate = width - 1 - distance;
+      brightness = sv600_line_luminance_percentile(
+        image, width, height, horizontal, coordinate,
+        horizontal ? horizontal_start : vertical_start,
+        horizontal ? horizontal_end : vertical_end, 20);
+      if (brightness < threshold)
+        *crops[side] = min(maximum_crop, distance + 2);
+    }
+    if (*crops[side] || connected_depths[side] >= 0)
+      *crops[side] = min(maximum_crop,
+        max(*crops[side], connected_depths[side] + 1) + safety);
+  }
+
+  DBG (15, "sv600_detect_clean_crop: connected=%d:%d:%d:%d safety=%d:%d\n",
+       connected_depths[2], connected_depths[0],
+       connected_depths[3], connected_depths[1], safety_x, safety_y);
+}
+
+/* The SV600 scans a projected view of the mat.  ScanSnap Home identifies the
+ * document after acquisition and applies a perspective transform.  Reproduce
+ * the useful flat-document part here without adding an OpenCV dependency. */
+static SANE_Status
+buffer_sv600_perspective(struct fujitsu *s, int side,
+                         int requested_portrait)
+{
+  SANE_Parameters *params = &s->s_params;
+  unsigned long histogram[256];
+  unsigned char *mask = NULL;
+  unsigned char *corrected = NULL;
+  int *queue = NULL;
+  struct sv600_point corners[4];
+  double coefficients[8];
+  int source_width = params->pixels_per_line;
+  int source_height = params->lines;
+  int step;
+  int grid_width;
+  int grid_height;
+  int grid_size;
+  int threshold = 96;
+  int best_count = 0;
+  int best_x[4] = {0, 0, 0, 0};
+  int best_y[4] = {0, 0, 0, 0};
+  int output_width;
+  int output_height;
+  int output_portrait;
+  int rotation = 0;
+  int crop_left;
+  int crop_top;
+  int crop_right;
+  int crop_bottom;
+  size_t output_bytes;
+  int index;
+  SANE_Status ret = SANE_STATUS_GOOD;
+
+  DBG (10, "buffer_sv600_perspective: start\n");
+
+  if (params->format != SANE_FRAME_RGB || params->depth != 8
+      || params->bytes_per_line < source_width * 3
+      || source_width < 64 || source_height < 64) {
+    DBG (5, "buffer_sv600_perspective: unsupported image format\n");
+    goto cleanup;
+  }
+
+  /* Corner errors are amplified across a perspective-corrected page.  Keep
+   * the detection grid fine enough for A4 rules to remain square while still
+   * avoiding a full-resolution flood-fill allocation. */
+  step = max(source_width, source_height) / 1280;
+  if (step < 1)
+    step = 1;
+  grid_width = (source_width + step - 1) / step;
+  grid_height = (source_height + step - 1) / step;
+  grid_size = grid_width * grid_height;
+
+  mask = calloc((size_t)grid_size, 1);
+  queue = malloc((size_t)grid_size * sizeof(*queue));
+  if (!mask || !queue) {
+    DBG (5, "buffer_sv600_perspective: cannot allocate detection buffers\n");
+    goto cleanup;
+  }
+
+  memset(histogram, 0, sizeof(histogram));
+  for (index = 0; index < grid_size; index++) {
+    int grid_x = index % grid_width;
+    int grid_y = index / grid_width;
+    int source_x = min(grid_x * step, source_width - 1);
+    int source_y = min(grid_y * step, source_height - 1);
+    const unsigned char *pixel = s->buffers[side]
+      + (size_t)source_y * params->bytes_per_line + source_x * 3;
+    histogram[sv600_luminance(pixel)]++;
+  }
+
+  {
+    unsigned long total = (unsigned long)grid_size;
+    unsigned long background_count = 0;
+    double weighted_total = 0;
+    double background_sum = 0;
+    double best_variance = -1;
+    int value;
+
+    for (value = 0; value < 256; value++)
+      weighted_total += value * (double)histogram[value];
+    for (value = 0; value < 255; value++) {
+      unsigned long foreground_count;
+      double background_mean;
+      double foreground_mean;
+      double variance;
+      background_count += histogram[value];
+      background_sum += value * (double)histogram[value];
+      foreground_count = total - background_count;
+      if (!background_count || !foreground_count)
+        continue;
+      background_mean = background_sum / background_count;
+      foreground_mean = (weighted_total - background_sum) / foreground_count;
+      variance = background_count * (double)foreground_count
+        * (background_mean - foreground_mean)
+        * (background_mean - foreground_mean);
+      if (variance > best_variance) {
+        best_variance = variance;
+        threshold = value;
+      }
+    }
+    threshold = max(48, min(176, threshold));
+  }
+
+  for (index = 0; index < grid_size; index++) {
+    int grid_x = index % grid_width;
+    int grid_y = index / grid_width;
+    int source_x = min(grid_x * step, source_width - 1);
+    int source_y = min(grid_y * step, source_height - 1);
+    const unsigned char *pixel = s->buffers[side]
+      + (size_t)source_y * params->bytes_per_line + source_x * 3;
+    if (sv600_luminance(pixel) > threshold)
+      mask[index] = 1;
+  }
+
+  for (index = 0; index < grid_size; index++) {
+    int head;
+    int tail;
+    int count;
+    int corner_x[4];
+    int corner_y[4];
+    int corner_score[4];
+
+    if (mask[index] != 1)
+      continue;
+    head = 0;
+    tail = 0;
+    count = 0;
+    queue[tail++] = index;
+    mask[index] = 2;
+    corner_score[0] = corner_score[3] = grid_width + grid_height + 1;
+    corner_score[1] = corner_score[2] = -grid_width - grid_height - 1;
+
+    while (head < tail) {
+      int position = queue[head++];
+      int x = position % grid_width;
+      int y = position / grid_width;
+      int score;
+      count++;
+
+      score = x + y;
+      if (score < corner_score[0]) {
+        corner_score[0] = score;
+        corner_x[0] = x;
+        corner_y[0] = y;
+      }
+      if (score > corner_score[2]) {
+        corner_score[2] = score;
+        corner_x[2] = x;
+        corner_y[2] = y;
+      }
+      score = x - y;
+      if (score > corner_score[1]) {
+        corner_score[1] = score;
+        corner_x[1] = x;
+        corner_y[1] = y;
+      }
+      if (score < corner_score[3]) {
+        corner_score[3] = score;
+        corner_x[3] = x;
+        corner_y[3] = y;
+      }
+
+      if (x > 0 && mask[position - 1] == 1) {
+        mask[position - 1] = 2;
+        queue[tail++] = position - 1;
+      }
+      if (x + 1 < grid_width && mask[position + 1] == 1) {
+        mask[position + 1] = 2;
+        queue[tail++] = position + 1;
+      }
+      if (y > 0 && mask[position - grid_width] == 1) {
+        mask[position - grid_width] = 2;
+        queue[tail++] = position - grid_width;
+      }
+      if (y + 1 < grid_height && mask[position + grid_width] == 1) {
+        mask[position + grid_width] = 2;
+        queue[tail++] = position + grid_width;
+      }
+    }
+
+    if (count > best_count) {
+      int corner;
+      best_count = count;
+      for (corner = 0; corner < 4; corner++) {
+        best_x[corner] = corner_x[corner];
+        best_y[corner] = corner_y[corner];
+      }
+    }
+  }
+
+  if (best_count < grid_size / 20) {
+    DBG (5, "buffer_sv600_perspective: document was not detected\n");
+    goto cleanup;
+  }
+
+  for (index = 0; index < 4; index++) {
+    int coarse_x = min(best_x[index] * step, source_width - 1);
+    int coarse_y = min(best_y[index] * step, source_height - 1);
+    int radius = step * 8;
+    int x_direction = (index == 0 || index == 3) ? 1 : -1;
+    int y_direction = (index == 0 || index == 1) ? 1 : -1;
+    int best_score = (index == 0 || index == 3)
+      ? source_width + source_height + 1
+      : -source_width - source_height - 1;
+    int search_y;
+
+    corners[index].x = coarse_x;
+    corners[index].y = coarse_y;
+    for (search_y = max(1, coarse_y - radius);
+         search_y <= min(source_height - 2, coarse_y + radius);
+         search_y++) {
+      int search_x;
+      for (search_x = max(1, coarse_x - radius);
+           search_x <= min(source_width - 2, coarse_x + radius);
+           search_x++) {
+        const unsigned char *pixel = s->buffers[side]
+          + (size_t)search_y * params->bytes_per_line + search_x * 3;
+        const unsigned char *inside_x = s->buffers[side]
+          + (size_t)search_y * params->bytes_per_line
+          + (search_x + x_direction) * 3;
+        const unsigned char *inside_y = s->buffers[side]
+          + (size_t)(search_y + y_direction) * params->bytes_per_line
+          + search_x * 3;
+        int score;
+
+        /* Require two inward neighbours so isolated highlights on the dark
+         * mat cannot be mistaken for a page corner. */
+        if (sv600_luminance(pixel) <= threshold
+            || sv600_luminance(inside_x) <= threshold
+            || sv600_luminance(inside_y) <= threshold)
+          continue;
+        score = (index == 0 || index == 2)
+          ? search_x + search_y : search_x - search_y;
+        if (((index == 0 || index == 3) && score < best_score)
+            || ((index == 1 || index == 2) && score > best_score)) {
+          best_score = score;
+          corners[index].x = search_x;
+          corners[index].y = search_y;
+        }
+      }
+    }
+  }
+
+  {
+    double area = 0;
+    int corner;
+    for (corner = 0; corner < 4; corner++) {
+      int next = (corner + 1) % 4;
+      area += corners[corner].x * corners[next].y
+        - corners[next].x * corners[corner].y;
+    }
+    area = fabs(area) / 2;
+    if (area < source_width * (double)source_height / 5) {
+      DBG (5, "buffer_sv600_perspective: detected area is too small\n");
+      goto cleanup;
+    }
+  }
+
+  output_width = source_width;
+  output_height = source_height;
+  output_portrait = source_height >= source_width;
+  {
+    int min_x = corners[0].x;
+    int max_x = corners[0].x;
+    int min_y = corners[0].y;
+    int max_y = corners[0].y;
+    int corner;
+    int detected_width;
+    int detected_height;
+    double long_mm;
+    double short_mm;
+    int short_pixels;
+    int long_pixels;
+
+    for (corner = 1; corner < 4; corner++) {
+      min_x = min(min_x, corners[corner].x);
+      max_x = max(max_x, corners[corner].x);
+      min_y = min(min_y, corners[corner].y);
+      max_y = max(max_y, corners[corner].y);
+    }
+    detected_width = max_x - min_x + 1;
+    detected_height = max_y - min_y + 1;
+    output_portrait = detected_height >= detected_width;
+    long_mm = max(detected_width, detected_height) * 25.4
+      / max(s->resolution_x, s->resolution_y);
+    short_mm = min(detected_width, detected_height) * 25.4
+      / max(s->resolution_x, s->resolution_y);
+
+    /* A landscape A4 placed near the camera has a much deeper projected
+     * bounding box than its physical 210 mm side (about 244 mm in practice).
+     * Keep enough tolerance to recognize that trapezoid as A4 before the
+     * homography restores the exact 297:210 aspect ratio. */
+    if (long_mm >= 270 && long_mm <= 320
+        && short_mm >= 180 && short_mm <= 260) {
+      short_pixels = (int)(210.0 * s->resolution_x / 25.4 + 0.5);
+      long_pixels = (int)(297.0 * s->resolution_y / 25.4 + 0.5);
+      output_width = output_portrait ? short_pixels : long_pixels;
+      output_height = output_portrait ? long_pixels : short_pixels;
+    }
+    else if (long_mm >= 390 && long_mm <= 440
+             && short_mm >= 270 && short_mm <= 320) {
+      short_pixels = (int)(297.0 * s->resolution_x / 25.4 + 0.5);
+      long_pixels = (int)(420.0 * s->resolution_y / 25.4 + 0.5);
+      output_width = output_portrait ? short_pixels : long_pixels;
+      output_height = output_portrait ? long_pixels : short_pixels;
+    }
+  }
+
+  output_bytes = (size_t)output_width * output_height * 3;
+  if (output_bytes > (size_t)s->buff_tot[side]) {
+    DBG (5, "buffer_sv600_perspective: corrected image exceeds buffer\n");
+    goto cleanup;
+  }
+  if (!sv600_solve_perspective(corners, output_width, output_height,
+                               coefficients)) {
+    DBG (5, "buffer_sv600_perspective: singular transform\n");
+    goto cleanup;
+  }
+
+  corrected = malloc(output_bytes);
+  if (!corrected) {
+    DBG (5, "buffer_sv600_perspective: cannot allocate output image\n");
+    goto cleanup;
+  }
+
+  sv600_render_perspective(s, side, corrected,
+                           source_width, source_height,
+                           output_width, output_height, output_portrait,
+                           coefficients, 0, 0, 0, 0);
+  sv600_detect_clean_crop(corrected, output_width, output_height,
+                          max(1, (int)(s->resolution_x / 25.4 + 0.5)),
+                          max(1, (int)(s->resolution_y / 25.4 + 0.5)),
+                          &crop_left, &crop_top, &crop_right, &crop_bottom);
+  if (crop_left || crop_top || crop_right || crop_bottom)
+    sv600_render_perspective(s, side, corrected,
+                             source_width, source_height,
+                             output_width, output_height, output_portrait,
+                             coefficients,
+                             crop_left, crop_top, crop_right, crop_bottom);
+
+  /* The user-facing scan window carries the orientation selected in the
+   * application.  A sideways A4 is acquired in its natural landscape shape
+   * for maximum SV600 quality, then rotated by moving whole RGB pixels.  This
+   * adds no resampling pass and therefore cannot soften text.  With the usual
+   * placement (the top of the page at the camera's right), portrait output is
+   * a counter-clockwise rotation. */
+  if (requested_portrait != output_portrait) {
+    int original_width = output_width;
+    int original_height = output_height;
+    int y;
+
+    if (requested_portrait) {
+      for (y = 0; y < original_height; y++) {
+        int x;
+        for (x = 0; x < original_width; x++) {
+          const unsigned char *source = corrected
+            + ((size_t)y * original_width + x) * 3;
+          unsigned char *destination = s->buffers[side]
+            + ((size_t)(original_width - 1 - x) * original_height + y) * 3;
+          memcpy(destination, source, 3);
+        }
+      }
+      rotation = 270;
+    }
+    else {
+      for (y = 0; y < original_height; y++) {
+        int x;
+        for (x = 0; x < original_width; x++) {
+          const unsigned char *source = corrected
+            + ((size_t)y * original_width + x) * 3;
+          unsigned char *destination = s->buffers[side]
+            + ((size_t)x * original_height + original_height - 1 - y) * 3;
+          memcpy(destination, source, 3);
+        }
+      }
+      rotation = 90;
+    }
+    output_width = original_height;
+    output_height = original_width;
+  }
+  else
+    memcpy(s->buffers[side], corrected, output_bytes);
+  params->pixels_per_line = output_width;
+  params->bytes_per_line = output_width * 3;
+  params->lines = output_height;
+  update_u_params(s);
+  s->bytes_rx[side] = (int)output_bytes;
+  s->buff_rx[side] = (int)output_bytes;
+
+  DBG (15, "buffer_sv600_perspective: threshold=%d corners="
+       "%.0f:%.0f,%.0f:%.0f,%.0f:%.0f,%.0f:%.0f output=%dx%d "
+       "crop=%d:%d:%d:%d rotation=%d\n",
+       threshold,
+       corners[0].x, corners[0].y,
+       corners[1].x, corners[1].y,
+       corners[2].x, corners[2].y,
+       corners[3].x, corners[3].y,
+       output_width, output_height,
+       crop_left, crop_top, crop_right, crop_bottom, rotation);
+
+cleanup:
+  free(corrected);
+  free(queue);
+  free(mask);
+  DBG (10, "buffer_sv600_perspective: finish\n");
+  return ret;
+}
+
