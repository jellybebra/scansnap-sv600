 }
 
+static SANE_Status
+sv600_diag_preread (struct fujitsu *s, int fixed_page)
+{
+  /* PfuSsCtl.dll's paper table is expressed in millimetres.  SshCtl.dll
+   * converts those dimensions to the scanner protocol's 1/1200-inch units
+   * and sends diagnostic command 0x117 ("SET PRE READMODE"). */
+  static const struct {
+    int page;
+    unsigned long width;
+    unsigned long length;
+  } formats[] = {
+    { 3, 14031, 19842 }, /* A3: 297 x 420 mm */
+    { 4,  9921, 14031 }, /* A4: 210 x 297 mm */
+    { 5,  6992,  9921 }  /* A5: 148 x 210 mm */
+  };
+  unsigned char payload[SD_preread_len - SD_preread_stringlen];
+  size_t i;
+
+  if (!strstr(s->model_name, "SV600") || !fixed_page)
+    return SANE_STATUS_GOOD;
+
+  for (i = 0; i < sizeof(formats) / sizeof(formats[0]); i++) {
+    if (formats[i].page == fixed_page) {
+      memset(payload, 0, sizeof(payload));
+      putnbyte(payload + 0x00, 300, 2);
+      putnbyte(payload + 0x02, 300, 2);
+      putnbyte(payload + 0x04, formats[i].width, 4);
+      putnbyte(payload + 0x08, formats[i].length, 4);
+      putnbyte(payload + 0x0c, 5, 1);
+      putnbyte(payload + 0x0d, 0, 1);
+      DBG (15, "sv600_diag_preread: page=%d width=%lu length=%lu\n",
+           fixed_page, formats[i].width, formats[i].length);
+      return sv600_send_diagnostic(s, SD_preread_string, payload,
+                                   sizeof(payload));
+    }
+  }
+
+  return SANE_STATUS_INVAL;
+}
